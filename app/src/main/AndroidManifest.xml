<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 자동차(AAOS) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <!-- 음성 대답 듣기 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 속도(실행 중 허락 필요)·기어: 안드로이드 차량 API (docs/PLEOS_NOTES.md 5장) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- Pleos Vehicle SDK: 브레이크(CAR_DRIVE), 방향지시등(CAR_LIGHTS) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />

    <!-- Pleos NaviHelper SDK: 경유지 추가·조회 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <application
        android:name=".WakeonApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wakeon">

        <!-- 창 크기는 기기가 정한다(1:1 세로, 2:0 가로). 방향을 고정하지 않고, 크기가 바뀌어도 다시 만들지 않는다. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <!-- 주행 중에도 화면을 막지 않도록 표시 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 시연 신호: adb shell am broadcast -a com.wakeon.app.DEMO -p com.wakeon.app ...
             DUMP 권한은 adb 셸만 가지고 있어서, 다른 앱은 시연 신호를 보낼 수 없다. -->
        <receiver
            android:name=".demo.DemoReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.wakeon.app.DEMO" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
